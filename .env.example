# Copy to .env.local and fill only with real development project values.
# Dashboard: Connect, or Settings > API Keys. Never use secret/service_role here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical browser origin for server Auth callbacks; match the Supabase allowlist.
NEXT_PUBLIC_APP_URL=http://localhost:3000
